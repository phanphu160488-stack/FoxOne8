                break
        lines.append(f'\n<b>Tổng: {len(approved)} thiết bị</b>')
        tg_send(chat_id, '\n'.join(lines))

    elif cmd == '/pendingdev':
        # /pendingdev — liệt kê các yêu cầu duyệt device đang chờ
